<Window x:Class="AaryanBillingApp.UI.Views.Categories.AddCategoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <StackPanel>

            <TextBlock Text="{Binding WindowTitle}"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Margin="0,5,0,0"
                       Foreground="Gray"
                       Text="Create or update a category."/>

        </StackPanel>

        <!-- Form -->

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <!-- Category Name -->

                <TextBlock Grid.Row="0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="Category Name"/>

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Height="36"
                         VerticalContentAlignment="Center"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Description -->

                <TextBlock Grid.Row="1"
                           VerticalAlignment="Top"
                           Margin="0,8,0,0"
                           FontWeight="SemiBold"
                           Text="Description"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Active -->

                <CheckBox Grid.Row="2"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Content="Category is Active"
                          IsChecked="{Binding IsActive}" />

            </Grid>

        </Border>

        <!-- Footer -->

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Width="110"
                    Height="40"
                    Margin="0,0,10,0"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                    Command="{Binding SaveCommand}"
                    Content="Save"/>

            <Button Width="110"
                    Height="40"
                    Command="{Binding CancelCommand}"
                    Content="Cancel"/>

        </StackPanel>

    </Grid>

</Window>