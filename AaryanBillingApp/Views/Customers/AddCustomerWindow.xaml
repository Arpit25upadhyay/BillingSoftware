<Window x:Class="AaryanBillingApp.UI.Views.Customers.AddCustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Customer"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock
                Text="Customer Details"
                FontSize="24"
                FontWeight="Bold"
                Margin="0,0,0,20"/>

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Customer Code -->

                <StackPanel Grid.Row="0">

                    <TextBlock Text="Customer Code"/>

                    <TextBox
                        Text="{Binding Customer.CustomerCode}"
                        IsReadOnly="True"/>

                </StackPanel>

                <!-- Customer Name -->

                <StackPanel Grid.Row="0"
                            Grid.Column="2">

                    <TextBlock Text="Customer Name *"/>

                    <TextBox
                        Text="{Binding Customer.Name,
                               UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>

                <!-- Mobile -->

                <StackPanel Grid.Row="2">

                    <TextBlock Text="Mobile *"/>

                    <TextBox
                        Text="{Binding Customer.Mobile,
                               UpdateSourceTrigger=PropertyChanged}"/>

                </StackPanel>

                <!-- Email -->

                <StackPanel Grid.Row="2"
                            Grid.Column="2">

                    <TextBlock Text="Email"/>

                    <TextBox
                        Text="{Binding Customer.Email}"/>

                </StackPanel>

                <!-- Gender -->

                <StackPanel Grid.Row="4">

                    <TextBlock Text="Gender"/>

                    <ComboBox
                        ItemsSource="{Binding Genders}"
                        SelectedItem="{Binding Customer.Gender}"/>

                </StackPanel>

                <!-- DOB -->

                <StackPanel Grid.Row="4"
                            Grid.Column="2">

                    <TextBlock Text="Date of Birth"/>

                    <DatePicker
                        SelectedDate="{Binding Customer.DateOfBirth}"/>

                </StackPanel>

                <!-- GST -->

                <StackPanel Grid.Row="6">

                    <TextBlock Text="GST Number"/>

                    <TextBox
                        Text="{Binding Customer.GSTNumber}"/>

                </StackPanel>

                <!-- Credit Limit -->

                <StackPanel Grid.Row="6"
                            Grid.Column="2">

                    <TextBlock Text="Credit Limit"/>

                    <TextBox
                        Text="{Binding Customer.CreditLimit}"/>

                </StackPanel>

                <!-- Address -->

                <StackPanel Grid.Row="8"
                            Grid.ColumnSpan="3">

                    <TextBlock Text="Address"/>

                    <TextBox
                        Height="60"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        Text="{Binding Customer.Address}"/>

                </StackPanel>

                <!-- City -->

                <StackPanel Grid.Row="10">

                    <TextBlock Text="City"/>

                    <TextBox
                        Text="{Binding Customer.City}"/>

                </StackPanel>

                <!-- State -->

                <StackPanel Grid.Row="10"
                            Grid.Column="2">

                    <TextBlock Text="State"/>

                    <TextBox
                        Text="{Binding Customer.State}"/>

                </StackPanel>

                <!-- Pincode -->

                <StackPanel Grid.Row="12">

                    <TextBlock Text="Pincode"/>

                    <TextBox
                        Text="{Binding Customer.Pincode}"/>

                </StackPanel>

                <!-- Opening Balance -->

                <StackPanel Grid.Row="12"
                            Grid.Column="2">

                    <TextBlock Text="Opening Balance"/>

                    <TextBox
                        Text="{Binding Customer.OpeningBalance}"/>

                </StackPanel>

            </Grid>

            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,25,0,0">

                <CheckBox
                    Content="Active"
                    Margin="0,0,20,0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding Customer.IsActive}"/>

                <Button
                    Width="100"
                    Margin="0,0,10,0"
                    Content="Save"
                    Command="{Binding SaveCommand}"/>

                <Button
                    Width="100"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>