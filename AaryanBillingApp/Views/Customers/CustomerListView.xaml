<UserControl x:Class="AaryanBillingApp.UI.Views.Customers.CustomerListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->

        <DockPanel Grid.Row="0"
                   Margin="0,0,0,15">

            <TextBlock Text="Customers"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right">

                <Button Content="Add Customer"
                        Width="120"
                        Margin="5"
                        Command="{Binding AddCustomerCommand}" />

                <Button Content="Edit"
                        Width="90"
                        Margin="5"
                        Command="{Binding EditCustomerCommand}" />

                <Button Content="Delete"
                        Width="90"
                        Margin="5"
                        Command="{Binding DeleteCustomerCommand}" />

                <Button Content="Refresh"
                        Width="90"
                        Margin="5"
                        Command="{Binding RefreshCommand}" />

            </StackPanel>

        </DockPanel>

        <!-- Search -->

        <Grid Grid.Row="1"
              Margin="0,0,0,15">

            <TextBox Width="300"
                     Height="35"
                     HorizontalAlignment="Left"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText,
                                    UpdateSourceTrigger=PropertyChanged}" />

        </Grid>

        <!-- Customer Grid -->

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Customers}"
                  SelectedItem="{Binding SelectedCustomer}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Code"
                                    Width="120"
                                    Binding="{Binding CustomerCode}" />

                <DataGridTextColumn Header="Customer Name"
                                    Width="*"
                                    Binding="{Binding Name}" />

                <DataGridTextColumn Header="Mobile"
                                    Width="130"
                                    Binding="{Binding Mobile}" />

                <DataGridTextColumn Header="City"
                                    Width="140"
                                    Binding="{Binding City}" />

                <DataGridTextColumn Header="Opening Balance"
                                    Width="140"
                                    Binding="{Binding OpeningBalance,
                                                      StringFormat=N2}" />

                <DataGridTextColumn Header="Loyalty Points"
                                    Width="120"
                                    Binding="{Binding LoyaltyPoints}" />

                <DataGridCheckBoxColumn Header="Active"
                                        Width="80"
                                        Binding="{Binding IsActive}" />

            </DataGrid.Columns>

        </DataGrid>

    </Grid>

</UserControl>