<UserControl x:Class="AaryanBillingApp.UI.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    
    

    <Grid Margin="40">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <TextBlock Grid.Row="0"
                   Text="Sales Report"
                   FontSize="28"
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- FILTER -->

        <Border Grid.Row="1"
                BorderBrush="LightGray"
                BorderThickness="1"
                Padding="15"
                Margin="0,0,0,15">

            <StackPanel Orientation="Horizontal">

                <TextBlock Text="From Date:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <DatePicker SelectedDate="{Binding FromDate}"
                            Width="140"/>

                <TextBlock Text="To Date:"
                           VerticalAlignment="Center"
                           Margin="25,0,8,0"/>

                <DatePicker SelectedDate="{Binding ToDate}"
                            Width="140"/>

                <Button Content="Generate"
                        Command="{Binding GenerateSalesReportCommand}"
                        Width="110"
                        Height="30"
                        Margin="25,0,0,0"/>

                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Width="100"
                        Height="30"
                        Margin="10,0,0,0"/>

            </StackPanel>

        </Border>

        <!-- SALES GRID -->

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding SalesReports}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Margin="0,0,0,15">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Invoice No"
                                    Binding="{Binding InvoiceNo}"
                                    Width="120"/>

                <DataGridTextColumn Header="Date"
                                    Binding="{Binding InvoiceDate, StringFormat={}{0:dd-MM-yyyy}}"
                                    Width="110"/>

                <DataGridTextColumn Header="Customer"
                                    Binding="{Binding CustomerName}"
                                    Width="180"/>

                <DataGridTextColumn Header="Sub Total"
                                    Binding="{Binding SubTotal, StringFormat={}{0:N2}}"
                                    Width="100"/>

                <DataGridTextColumn Header="Discount"
                                    Binding="{Binding DiscountAmount, StringFormat={}{0:N2}}"
                                    Width="100"/>

                <DataGridTextColumn Header="Tax"
                                    Binding="{Binding TaxAmount, StringFormat={}{0:N2}}"
                                    Width="100"/>

                <DataGridTextColumn Header="Grand Total"
                                    Binding="{Binding GrandTotal, StringFormat={}{0:N2}}"
                                    Width="110"/>

                <DataGridTextColumn Header="Paid"
                                    Binding="{Binding PaidAmount, StringFormat={}{0:N2}}"
                                    Width="100"/>

                <DataGridTextColumn Header="Due"
                                    Binding="{Binding DueAmount, StringFormat={}{0:N2}}"
                                    Width="100"/>

                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"
                                    Width="100"/>

            </DataGrid.Columns>

        </DataGrid>

        <!-- SUMMARY -->

        <Border Grid.Row="3"
                BorderBrush="LightGray"
                BorderThickness="1"
                Padding="15">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <StackPanel Margin="20,0">
                    <TextBlock Text="Total Sales"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TotalSales, StringFormat=₹ {0:N2}}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Margin="20,0">
                    <TextBlock Text="Discount"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TotalDiscount, StringFormat=₹ {0:N2}}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Margin="20,0">
                    <TextBlock Text="Tax"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TotalTax, StringFormat=₹ {0:N2}}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Margin="20,0">
                    <TextBlock Text="Paid"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TotalPaid, StringFormat=₹ {0:N2}}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Margin="20,0">
                    <TextBlock Text="Due"
                               FontWeight="Bold"/>

                    <TextBlock Text="{Binding TotalDue, StringFormat=₹ {0:N2}}"
                               FontSize="18"
                               FontWeight="Bold"/>
                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>