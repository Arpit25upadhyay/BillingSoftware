<Window x:Class="AaryanBillingApp.UI.Views.Products.AddProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add Product"
        Height="720"
        Width="950"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- PRODUCT DETAILS -->

            <GroupBox Header="Product Details"
                      FontSize="15"
                      FontWeight="SemiBold"
                      Padding="15"
                      Margin="0,0,0,15">

                <Grid Margin="5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="90"/>
                    </Grid.RowDefinitions>

                    <!-- Category -->

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Category" FontWeight="SemiBold"/>
                        <TextBlock Text=" *" Foreground="Red" FontWeight="Bold"/>
                    </StackPanel>



                    <ComboBox Grid.Column="1"
                                  Height="34"
                                  Margin="5"
                                  ItemsSource="{Binding Categories}"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding Product.CategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name"/>



                    <!-- Brand -->

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                        <TextBlock Text="Brand" FontWeight="SemiBold"/>

                        <TextBlock Text=" *" Foreground="Red" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0"
                                Grid.Column="4"
                                Orientation="Horizontal">



                        <ComboBox Height="34"
                                  Width="220"
                                  Margin="5"
                                  ItemsSource="{Binding Brands}"
                                  SelectedValue="{Binding Product.BrandId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="Name"/>

                        <Button Width="36"
                                Height="34"
                                Margin="5,0,0,0"
                                Content="+"
                                Command="{Binding AddBrandCommand}"
                                ToolTip="Add New Category"/>

                    </StackPanel>

                    <!-- Unit -->

                    <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                        <TextBlock Text="Unit"
               FontWeight="SemiBold"/>

                        <TextBlock Text=" *"
               Foreground="Red"
               FontWeight="Bold"/>
                    </StackPanel>

                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              Height="34"
                              Margin="5"
                              ItemsSource="{Binding Units}"
                              SelectedValue="{Binding Product.UnitId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"/>

                    <!-- Product Name -->

                    <StackPanel Grid.Row="1"
            Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                        <TextBlock Text="Product Name"
               FontWeight="SemiBold"/>

                        <TextBlock Text=" *"
               Foreground="Red"
               FontWeight="Bold"/>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Grid.Column="3"
                             Height="34"
                             Margin="5"
                             VerticalContentAlignment="Center"
                             Text="{Binding Product.Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <!-- HSN -->

                    <TextBlock Grid.Row="2"
                               Text="HSN Code"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Height="34"
                             Margin="5"
                             VerticalContentAlignment="Center"
                             Text="{Binding Product.HSNCode}"/>

                    <!-- GST -->

                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Text="GST %"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Row="2"
                             Grid.Column="3"
                             Height="34"
                             Margin="5"
                             VerticalContentAlignment="Center"
                             Text="{Binding Product.GSTPercentage}"/>

                    <!-- Description -->

                    <TextBlock Grid.Row="3"
                               Text="Description"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               Margin="0,5,0,0"/>

                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             Grid.ColumnSpan="3"
                             Margin="5"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Product.Description}"/>

                </Grid>

            </GroupBox>

            <!-- VARIANT -->

            <GroupBox Grid.Row="1"
                      Header="Default Variant"
                      FontSize="15"
                      FontWeight="SemiBold"
                      Padding="15">

                <Grid Margin="5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="45"/>
                    </Grid.RowDefinitions>

                    <!-- Color -->

                    <Grid Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,11,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Color"
               FontWeight="SemiBold"
               VerticalAlignment="Center"
               Grid.Column="0"/>

                        <ComboBox Grid.Column="1"
              Height="34"
              Margin="16,6,40,5"
              ItemsSource="{Binding Colors}"
              SelectedValue="{Binding Variants[0].ColorId,
                                      Mode=TwoWay,
                                      UpdateSourceTrigger=PropertyChanged}"
              SelectedValuePath="Id"
              DisplayMemberPath="Name" Grid.ColumnSpan="2"/>

                        <Button Grid.Column="2"
            Content="+"
            Width="36"
            Height="34"
            Margin="14,6,-5,5"
            Command="{Binding AddColorCommand}" Click="Button_Click"/>
                    </Grid>

                    <!-- Size -->

                    <TextBlock Grid.Column="2"
                               Text="Size"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <ComboBox Grid.Column="3"
                              Height="34"
                              Margin="5"
                              ItemsSource="{Binding Sizes}"
                              SelectedValue="{Binding Variants[0].SizeId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"/>

                    <!-- Barcode -->

                    <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                        <TextBlock Text="Barcode"
               FontWeight="SemiBold"/>

                        <TextBlock Text=" *"
               Foreground="Red"
               FontWeight="Bold"/>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Height="34"
                             Margin="5"
                             VerticalContentAlignment="Center"
                             Text="{Binding Variants[0].Barcode}"/>

                    <!-- SKU -->
                    <StackPanel Grid.Row="1"
            Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                        <TextBlock Text="SKU"
               FontWeight="SemiBold"/>

                        <TextBlock Text=" *"
               Foreground="Red"
               FontWeight="Bold"/>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Grid.Column="3"
                             Height="34"
                             Margin="5"
                             VerticalContentAlignment="Center"
                             Text="{Binding Variants[0].SKU}"/>

                    <!-- Purchase Price -->

                    <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                        <TextBlock Text="Purchase Price"
               FontWeight="SemiBold"/>

                        <TextBlock Text=" *"
               Foreground="Red"
               FontWeight="Bold"/>
                    </StackPanel>

                    <TextBox Grid.Row="2"
                             Grid.Column="1"
                             Height="34"
                             Margin="5"
                             VerticalContentAlignment="Center"
                             Text="{Binding Variants[0].PurchasePrice}"/>

                    <!-- Selling Price -->

                    <StackPanel Grid.Row="2"
            Grid.Column="2"
            Orientation="Horizontal"
            VerticalAlignment="Center">

                        <TextBlock Text="Selling Price"
               FontWeight="SemiBold"/>

                        <TextBlock Text=" *"
               Foreground="Red"
               FontWeight="Bold"/>
                    </StackPanel>

                    <TextBox Grid.Row="2"
                             Grid.Column="3"
                             Height="34"
                             Margin="5"
                             VerticalContentAlignment="Center"
                             Text="{Binding Variants[0].SellingPrice}"/>

                    <!-- Opening Stock -->

                    <TextBlock Grid.Row="3"
                               Text="Opening Stock"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             Height="34"
                             Margin="5"
                             VerticalContentAlignment="Center"
                             Text="{Binding Variants[0].CurrentStock}"/>

                    <!-- Minimum Stock -->

                    <TextBlock Grid.Row="3"
                               Grid.Column="2"
                               Text="Minimum Stock"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Row="3"
                             Grid.Column="3"
                             Height="34"
                             Margin="5"
                             VerticalContentAlignment="Center"
                             Text="{Binding Variants[0].MinStock}"/>

                </Grid>

            </GroupBox>

            <!-- Buttons -->

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,-100" Width="890">

                <Button Content="Cancel"
                        Width="438"
                        Height="53"
                        Margin="0,0,10,0"
                        IsCancel="True"/>
                <Button Content="💾 Save"
                                Width="440"
                                Height="54"
                                FontWeight="SemiBold"
                                Command="{Binding SaveCommand}">

                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#1976D2"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderBrush" Value="#1976D2"/>
                            <Setter Property="Opacity" Value="1"/>

                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#D6D9DD"/>
                                    <Setter Property="Foreground" Value="#777777"/>
                                    <Setter Property="BorderBrush" Value="#D6D9DD"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>

                </Button>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>