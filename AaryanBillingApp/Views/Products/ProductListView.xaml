<UserControl x:Class="AaryanBillingApp.UI.Views.Products.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Background="#F5F7FA">

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->

        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="0,0,0,1">

            <Grid Margin="25,15">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Products"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock Text="Manage all products available in inventory."
                               Margin="0,5,0,0"
                               FontSize="14"
                               Foreground="Gray"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Height="45"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Content="+ Add Product"
                        Command="{Binding AddProductCommand}"/>

            </Grid>

        </Border>

        <!-- ================= DASHBOARD ================= -->

        <UniformGrid Grid.Row="1"
                     Margin="20"
                     Columns="4">

            <Border Margin="8"
                    Background="White"
                    CornerRadius="10">

                <StackPanel Orientation="Horizontal" Margin="20,20,10,20">

                    <TextBlock Text="Total Products"
                               FontSize="14"
                               Foreground="Gray" Width="113"/>
                    <TextBlock Text= "{Binding TotalProducts}"
                                       FontSize="14"
                                       FontWeight="Bold" Width="293" Height="22" TextWrapping="WrapWithOverflow" TextAlignment="Right"/>

                </StackPanel>

            </Border>

            <Border Margin="8"
                    Background="White"
                    CornerRadius="10">

                <StackPanel Margin="20" Orientation="Horizontal">

                    <TextBlock Text="Inventory Value"
                               FontSize="14"
                               Foreground="Gray"
                               Width="113"/>
                    <TextBlock Text="{Binding InventoryValue, StringFormat=₹\{0:N2\}}"
                               FontSize="14"
                               FontWeight="Bold" Width="293" Height="22" TextWrapping="WrapWithOverflow" TextAlignment="Right"/>

                </StackPanel>

            </Border>

            <Border Margin="8"
                    Background="White"
                    CornerRadius="10">

                <StackPanel Margin="20" Orientation="Horizontal">

                    <TextBlock Text="Low Stock"
                               FontSize="14"
                               Foreground="Gray"
                               Width="113"/>
                    <TextBlock Text="{Binding LowStock}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="Orange" Width="293" Height="22" TextWrapping="WrapWithOverflow" TextAlignment="Right"/>

                </StackPanel>

            </Border>

            <Border Margin="8"
                    Background="White"
                    CornerRadius="10">

                <StackPanel Margin="20" Orientation="Horizontal">

                    <TextBlock Text="Active Products"
                               FontSize="14"
                               Foreground="Gray" Width="113"/>
                    <TextBlock Text="{Binding ActiveProducts}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#059669" Width="293" Height="22" TextWrapping="WrapWithOverflow" TextAlignment="Right"/>

                </StackPanel>

            </Border>

        </UniformGrid>

        <!-- ================= SEARCH ================= -->

        <Grid Grid.Row="2"
              Margin="20,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="350"/>

                <ColumnDefinition Width="10"/>

                <ColumnDefinition Width="140"/>

                <ColumnDefinition Width="10"/>

                <ColumnDefinition Width="120"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Height="42"
                     Padding="10"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

            <Button Grid.Column="2"
                    Height="42"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"/>

            <Button Grid.Column="4"
                    Height="42"
                    Content="Export"/>

        </Grid>

        <!-- ================= PRODUCT GRID ================= -->

        <Border Grid.Row="3"
                Margin="20"
                Background="White"
                CornerRadius="10"
                BorderBrush="#E5E7EB"
                BorderThickness="1">

            <DataGrid ItemsSource="{Binding Products}"
                      SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeight="42"
                      ColumnHeaderHeight="45">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Width="70"
                                        Binding="{Binding ProductId}" />

                    <DataGridTextColumn Header="Barcode"
                                        Width="160"
                                        Binding="{Binding Barcode}" />

                    <DataGridTextColumn Header="Product Name"
                                        Width="250"
                                        Binding="{Binding ProductName}" />

                    <DataGridTextColumn Header="Category"
                                        Width="170"
                                        Binding="{Binding CategoryName}" />
                    <DataGridTextColumn Header="Color"
                                        Width="120"
                                        Binding="{Binding ColorName}" />
                    <DataGridTextColumn Header="Size"
                                        Width="100"
                                        Binding="{Binding SizeName}" />
                    <DataGridTextColumn Header="Units"
                                        Width="90"
                                        Binding="{Binding UnitName}" />

                    <DataGridTextColumn Header="Brand"
                                        Width="160"
                                        Binding="{Binding BrandName}" />


                    <DataGridTextColumn Header="Purchase Price"
                                        Width="130"
                                        Binding="{Binding PurchasePrice,StringFormat=₹{0:N2}}" />

                    <DataGridTextColumn Header="Selling Price"
                                        Width="130"
                                        Binding="{Binding SellingPrice,StringFormat=₹{0:N2}}" />

                    <DataGridTextColumn Header="Stock"
                                        Width="100"
                                        Binding="{Binding CurrentStock}" />

                    <DataGridTemplateColumn Header="Status" Width="120">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <Border Padding="8,3"
                                        CornerRadius="12"
                                        HorizontalAlignment="Center">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Background" Value="#FEE2E2"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsActive}" Value="True">

                                                    <Setter Property="Background" Value="#DCFCE7"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock FontWeight="SemiBold">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Text" Value="Inactive"/>

                                                <Setter Property="Foreground" Value="#B91C1C"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">

                                                        <Setter Property="Text" Value="Active"/>

                                                        <Setter Property="Foreground" Value="#15803D"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                </Border>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Actions"
                                            Width="180">

                        <DataGridTemplateColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center">

                                    <Button Width="70"
                                            Height="30"
                                            Margin="0,0,8,0"
                                            Background="#2563EB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Content="Edit"
                                            Command="{Binding DataContext.EditProductCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />

                                    <Button Width="75"
                                            Height="30"
                                            Background="#DC2626"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Content="Delete"
                                            Command="{Binding DataContext.DeleteProductCommand,
                                                              RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" />

                                </StackPanel>

                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>

                </DataGrid.Columns>

            </DataGrid>

        </Border>
        <!-- DataGrid Row Style -->

        <Grid.Resources>

            <Style TargetType="DataGridColumnHeader">

                <Setter Property="Background" Value="#F3F4F6"/>
                <Setter Property="Foreground" Value="#374151"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="10"/>
                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>

            </Style>

            <Style TargetType="DataGridRow">

                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>

                <Style.Triggers>

                    <Trigger Property="IsMouseOver"
                             Value="True">

                        <Setter Property="Background"
                                Value="#F9FAFB"/>

                    </Trigger>

                    <Trigger Property="IsSelected"
                             Value="True">

                        <Setter Property="Background"
                                Value="#DBEAFE"/>

                        <Setter Property="Foreground"
                                Value="Black"/>

                    </Trigger>

                </Style.Triggers>

            </Style>

            <Style TargetType="DataGridCell">

                <Setter Property="Padding"
                        Value="8"/>

                <Setter Property="BorderThickness"
                        Value="0"/>

                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>

            </Style>

        </Grid.Resources>

    </Grid>

</UserControl>