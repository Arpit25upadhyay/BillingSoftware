<Window x:Class="AaryanBillingApp.UI.Views.Suppliers.AddSupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Supplier"
        Height="720"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer>

        <Grid Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>

                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="40"/>

                </Grid.RowDefinitions>

                <TextBlock Text="Supplier Code"/>
                <TextBox Grid.Column="1"
                         Text="{Binding Supplier.SupplierCode}"
                         IsReadOnly="True"/>

                <TextBlock Grid.Column="2"
                           Text="Company Name"/>

                <TextBox Grid.Column="3"
                         Text="{Binding Supplier.CompanyName}"/>

                <TextBlock Grid.Row="1"
                           Text="Contact Person"/>

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Text="{Binding Supplier.ContactPerson}"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Mobile"/>

                <TextBox Grid.Row="1"
                         Grid.Column="3"
                         Text="{Binding Supplier.Mobile}"/>

                <TextBlock Grid.Row="2"
                           Text="Alternate Mobile"/>

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Text="{Binding Supplier.AlternateMobile}"/>

                <TextBlock Grid.Row="2"
                           Grid.Column="2"
                           Text="Email"/>

                <TextBox Grid.Row="2"
                         Grid.Column="3"
                         Text="{Binding Supplier.Email}"/>

                <TextBlock Grid.Row="3"
                           Text="GST Number"/>

                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Text="{Binding Supplier.GSTNumber}"/>

                <TextBlock Grid.Row="3"
                           Grid.Column="2"
                           Text="PAN Number"/>

                <TextBox Grid.Row="3"
                         Grid.Column="3"
                         Text="{Binding Supplier.PANNumber}"/>

                <TextBlock Grid.Row="4"
                           Text="City"/>

                <TextBox Grid.Row="4"
                         Grid.Column="1"
                         Text="{Binding Supplier.City}"/>

                <TextBlock Grid.Row="4"
                           Grid.Column="2"
                           Text="State"/>

                <TextBox Grid.Row="4"
                         Grid.Column="3"
                         Text="{Binding Supplier.State}"/>

                <TextBlock Grid.Row="5"
                           Text="Pincode"/>

                <TextBox Grid.Row="5"
                         Grid.Column="1"
                         Text="{Binding Supplier.Pincode}"/>

                <TextBlock Grid.Row="5"
                           Grid.Column="2"
                           Text="Payment Days"/>

                <TextBox Grid.Row="5"
                         Grid.Column="3"
                         Text="{Binding Supplier.PaymentDays}"/>

                <TextBlock Grid.Row="6"
                           Text="Address"/>

                <TextBox Grid.Row="6"
                         Grid.Column="1"
                         Grid.ColumnSpan="3"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Text="{Binding Supplier.Address}"/>

                <TextBlock Grid.Row="7"
                           Text="Opening Balance"/>

                <TextBox Grid.Row="7"
                         Grid.Column="1"
                         Text="{Binding Supplier.OpeningBalance}"/>

            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <CheckBox Content="Active"
                          Margin="0,0,20,0"
                          IsChecked="{Binding Supplier.IsActive}"/>

                <Button Content="Save"
                        Width="100"
                        Margin="5"
                        Command="{Binding SaveCommand}"/>

                <Button Content="Cancel"
                        Width="100"
                        Margin="5"
                        Command="{Binding CancelCommand}"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Window>