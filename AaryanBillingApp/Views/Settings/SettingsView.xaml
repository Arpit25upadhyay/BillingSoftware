<UserControl x:Class="AaryanBillingApp.UI.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <TextBlock Text="Settings"
                       FontSize="26"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Width="90"
                    Height="32"
                    HorizontalAlignment="Right"/>

        </Grid>


        <!-- CONTENT -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <!-- SETTINGS LIST -->
            <Border Grid.Column="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Background="White">

                <ListBox ItemsSource="{Binding Settings}"
                         SelectedItem="{Binding SelectedSetting, Mode=TwoWay}"
                         BorderThickness="0">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border Padding="12"
                                    BorderBrush="#EEEEEE"
                                    BorderThickness="0,0,0,1">

                                <StackPanel>

                                    <TextBlock Text="{Binding SettingKey}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="Gray"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Border>


            <!-- EDIT PANEL -->
            <Border Grid.Column="2"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="5"
                    Background="White"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <!-- KEY -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding SelectedSetting.SettingKey}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>


                    <!-- DESCRIPTION -->
                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedSetting.Description}"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>


                    <!-- LABEL -->
                    <TextBlock Grid.Row="2"
                               Text="Value"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>


                    <!-- VALUE -->
                    <TextBox Grid.Row="3"
                             Text="{Binding SettingValue,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="36"
                             Padding="8"/>


                    <!-- SAVE -->
                    <Button Grid.Row="4"
                            Content="Save"
                            Command="{Binding SaveSettingCommand}"
                            Width="100"
                            Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,15,0,0"/>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>