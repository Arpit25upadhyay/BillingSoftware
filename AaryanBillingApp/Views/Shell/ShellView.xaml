<Window x:Class="AaryanBillingApp.UI.Views.Shell.ShellView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Aaryan Billing"
        Height="750"
        Width="1300"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Menu -->
        <Border Grid.Column="0"
                Background="#222831">

            <DockPanel>

                <!-- Logo -->
                <StackPanel DockPanel.Dock="Top"
                            Margin="20">

                    <TextBlock Text="Aaryan"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Billing Software"
                               FontSize="14"
                               Foreground="White"
                               Opacity="0.7"/>
                </StackPanel>

                <!-- Menu -->
                <StackPanel Margin="10,40,10,10">

                    <Button
                        Content="Dashboard"
                        Command="{Binding DashboardCommand}"
                        Height="45"
                        Margin="0,5"/>

                    <Button
                        Content="Products"
                        Command="{Binding ProductsCommand}"
                        Height="45"
                        Margin="0,5"/>

                    <Button
                        Content="Categories"
                        Command="{Binding CategoriesCommand}" 
                        Height="45"
                        Margin="0,5"/>

                    <Button
                        Content="Billing"
                        Command="{Binding BillingCommand}" 
                        Height="45"
                        Margin="0,5"/>

                    <Button
                        Content="Purchase"
                        Command="{Binding PurchaseCommand}" 
                        Height="45"
                        Margin="0,5"/>

                    <Button
                        Content="Customers"
                        Command="{Binding CustomersCommand}" 
                        Height="45"
                        Margin="0,5"/>

                    <Button
                        Content="Suppliers"
                        Command="{Binding SuppliersCommand}" 
                        Height="45"
                        Margin="0,5"/>

                    <Button
                        Content="Reports"
                        Command="{Binding ReportsCommand}" 
                        Height="45"
                        Margin="0,5"/>

                    <Button
                        Content="Settings"
                        Command="{Binding SettingsCommand}" 
                        Height="45"
                        Margin="0,5"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- Right Content -->
        <Border Grid.Column="1"
                Background="#F5F5F5">

            <ContentControl
                Content="{Binding CurrentView}"
                Margin="20"/>

        </Border>

    </Grid>

</Window>